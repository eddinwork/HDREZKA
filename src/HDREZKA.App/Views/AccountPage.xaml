<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HDREZKA.App.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Padding="28,12,28,12" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Logged in state -->
        <StackPanel x:Name="LoggedInPanel" Grid.Row="0" Orientation="Horizontal" Spacing="16" Visibility="Collapsed">
            <Grid Width="80" Height="80">
                <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                <TextBlock x:Name="AvatarInitial" FontSize="32" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse>
                    <Ellipse.Fill>
                        <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" ImageFailed="AvatarBrush_ImageFailed"/>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
            <StackPanel VerticalAlignment="Center" Spacing="4">
                <TextBlock x:Name="NicknameText" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="EmailText" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Not logged in state -->
        <StackPanel x:Name="LoggedOutPanel" Grid.Row="0" Orientation="Vertical" Spacing="12" HorizontalAlignment="Center" Visibility="Collapsed">
            <FontIcon Glyph="&#xE77B;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="LoginPromptText" FontSize="18" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="360"/>
            <Button x:Name="LoginButton" Click="LoginButton_Click" Style="{ThemeResource AccentButtonStyle}" MinWidth="200"/>
            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                <HyperlinkButton x:Name="RegisterLink" Click="RegisterLink_Click" Padding="0"/>
                <HyperlinkButton x:Name="PremiumLink" Click="PremiumLink_Click" Padding="0"/>
            </StackPanel>
            <HyperlinkButton x:Name="SuggestLinkLoggedOut" Click="SuggestLink_Click" HorizontalAlignment="Center" Padding="0"/>
        </StackPanel>

        <!-- Account actions -->
        <StackPanel x:Name="ActionsPanel" Grid.Row="1" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
            <Button x:Name="BookmarksButton" Click="BookmarksButton_Click" Style="{ThemeResource AccentButtonStyle}"/>
            <Button x:Name="HistoryButton" Click="HistoryButton_Click" Style="{ThemeResource AccentButtonStyle}"/>
            <HyperlinkButton x:Name="PremiumLinkLoggedIn" Click="PremiumLink_Click" VerticalAlignment="Center"/>
            <Button x:Name="SuggestButton" Click="SuggestLink_Click"/>
            <Button x:Name="LogoutButton" Click="LogoutButton_Click"/>
        </StackPanel>

        <!-- Info -->
        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock x:Name="DisclaimerText" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" MaxWidth="500"/>
        </StackPanel>

        <!-- Offline files -->
        <StackPanel x:Name="OfflinePanel" Grid.Row="3" Spacing="8" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock x:Name="OfflineHeader" Style="{StaticResource SectionHeader}"/>
            <ListView x:Name="OfflineList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OfflineList_ItemClick" MaxHeight="320">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,8" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                    Background="Transparent" BorderThickness="0" Padding="10,6"
                                    Tag="{Binding}" Click="OfflineDelete_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="OfflineEmptyText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            <Button x:Name="OfflineFolderButton" Click="OfflineFolderButton_Click" HorizontalAlignment="Left"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>