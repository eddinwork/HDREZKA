<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HDREZKA.App.Views.DetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HDREZKA.App.Controls"
    xmlns:api="using:HDREZKA.Core.Api"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="WatchAlsoTemplate" x:DataType="api:MovieSimple">
            <controls:MovieCard Movie="{x:Bind}"/>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid x:Name="MainPanel" Padding="36,16,36,24" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="HeaderGrid" ColumnSpacing="28" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="PosterPanel" Spacing="12">
                        <Border CornerRadius="10">
                            <Image x:Name="PosterImage" Width="280" Height="420" Stretch="UniformToFill"/>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="InfoPanel" Grid.Column="1" Spacing="10">
                        <TextBlock x:Name="TitleText" FontSize="30" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="OrigTitleText" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Auto"
                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="10">
                                <StackPanel x:Name="RatingsPanel" Orientation="Horizontal" Spacing="10" Margin="0,6,0,0"/>

                                <StackPanel x:Name="UserRatingPanel" Orientation="Horizontal" Spacing="10" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel x:Name="MetaPanel" Spacing="0" Margin="0,8,0,0"/>

                        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,12,0,0" MaxWidth="900" HorizontalAlignment="Left" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="VoicesPanel" Grid.Row="1" Spacing="8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="VoicesHeader" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                        <Button x:Name="VoicesRatingButton" Click="VoicesRatingButton_Click" Visibility="Collapsed"
                                Background="Transparent" BorderThickness="0" Padding="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE946;" FontSize="15"/>
                        </Button>
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Auto"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="VoicesList" Orientation="Horizontal" Spacing="8"/>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel x:Name="SeasonsPanel" Grid.Row="2" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="SeasonsHeader" Style="{StaticResource SectionHeader}"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox x:Name="SeasonBox" MinWidth="180" SelectionChanged="SeasonBox_SelectionChanged"/>
                        <Button x:Name="SeasonDownloadButton" Click="SeasonDownloadButton_Click" VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="14"/>
                                <TextBlock x:Name="SeasonDownloadText"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="EpisodesList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Auto"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ActionsRow" Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                    <Button x:Name="WatchButton" Click="WatchButton_Click" Style="{ThemeResource AccentButtonStyle}" MinHeight="40">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="16"/>
                            <TextBlock x:Name="WatchText" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BookmarkButton" Click="BookmarkButton_Click" MinHeight="40">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE734;" FontSize="16"/>
                            <TextBlock x:Name="BookmarkText"/>
                        </StackPanel>
                    </Button>
                    <ToggleButton x:Name="WatchedButton" Click="WatchedButton_Click" MinHeight="40">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="16"/>
                            <TextBlock x:Name="WatchedText"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="TrackButton" Click="TrackButton_Click" MinHeight="40">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE91C;" FontSize="16"/>
                            <TextBlock x:Name="TrackText"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="TrailerButton" Click="TrailerButton_Click" MinHeight="40">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE714;" FontSize="16"/>
                            <TextBlock x:Name="TrailerText"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DownloadButton" Click="DownloadButton_Click" MinHeight="40" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="16"/>
                            <TextBlock x:Name="DownloadText"/>
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="SchedulePanel" Grid.Row="4" Spacing="8" Margin="0,20,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ScheduleHeader" Style="{StaticResource SectionHeader}"/>
                    <Border x:Name="ScheduleCountdownBadge" Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="8" Padding="12,6" HorizontalAlignment="Left" Visibility="Collapsed">
                        <TextBlock x:Name="ScheduleCountdownText" Foreground="White" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock x:Name="ScheduleGroupText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <StackPanel x:Name="ScheduleList" Spacing="0"/>
                    <Button x:Name="ScheduleMoreButton" Click="ScheduleMoreButton_Click" Visibility="Collapsed"
                            Background="Transparent" BorderThickness="0" Padding="8,4" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel x:Name="CommentsSection" Grid.Row="5" Spacing="10" Margin="0,20,0,0" Visibility="Collapsed">                    <ToggleButton x:Name="CommentsToggle" Click="CommentsToggle_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE90A;" FontSize="16"/>
                            <TextBlock x:Name="CommentsToggleText"/>
                        </StackPanel>
                    </ToggleButton>

                    <StackPanel x:Name="CommentsPanel" Spacing="10" Visibility="Collapsed">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CommentInput" PlaceholderText="Comment…" MaxLength="2000" HorizontalAlignment="Stretch" MaxWidth="640" AcceptsReturn="False" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" x:Name="CommentSendButton" Click="CommentSendButton_Click" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Bottom"/>
                        </Grid>
                        <StackPanel x:Name="CommentsList" Spacing="4"/>
                        <Button x:Name="CommentsMoreButton" Click="CommentsMoreButton_Click" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="WatchAlsoPanel" Grid.Row="6" Spacing="0" Margin="0,20,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="WatchAlsoHeader" Style="{StaticResource RowHeaderText}"/>
                    <ListView x:Name="WatchAlsoGrid" SelectionMode="None" IsItemClickEnabled="False"
                              ItemTemplate="{StaticResource WatchAlsoTemplate}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollMode="Enabled"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,12,16"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Top"/>
                                <Setter Property="IsTabStop" Value="False"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ProgressRing IsActive="True" Width="44" Height="44"/>
        </StackPanel>

        <StackPanel x:Name="ErrorPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
            <FontIcon Glyph="&#xE783;" FontSize="36"/>
            <TextBlock x:Name="ErrorText" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
            <Button x:Name="RetryButton" Click="RetryButton_Click" HorizontalAlignment="Center" Style="{ThemeResource AccentButtonStyle}"/>
        </StackPanel>
    </Grid>
</Page>
